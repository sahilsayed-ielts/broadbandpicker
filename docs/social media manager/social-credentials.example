# Copy to docs/social media manager/.env.social (gitignored) and fill in.
# Never commit real tokens.

# X / Twitter (OAuth 1.0a user tokens with tweet.write + media)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn (community management token + author URN)
# Author is urn:li:organization:123456 for a company page, or urn:li:person:xxxx
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Facebook Page
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business (linked to that Page)
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# Optional: if Instagram cannot use an unpublished Facebook upload,
# host the file on HTTPS and set the folder URL (no trailing slash).
# SOCIAL_PUBLIC_BASE_URL=https://broadbandpicker.co.uk/social-posts
